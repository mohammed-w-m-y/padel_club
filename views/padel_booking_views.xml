<odoo>
    <record id="view_padel_booking_tree" model="ir.ui.view">
        <field name="name">padel.booking.tree</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-primary="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="court_id"/>
                <field name="member_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration_hours"/>
                <field name="price"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_padel_booking_form" model="ir.ui.view">
        <field name="name">padel.booking.form</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" states="draft"/>
                    <button name="action_done" string="Mark Done" type="object" class="oe_highlight" states="confirmed"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'confirmed'), ('invoice_id', '!=', False)]}"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,confirmed"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" states="cancelled"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="court_id"/>
                            <field name="member_id"/>
                            <field name="invoice_id" attrs="{'invisible': [('invoice_id', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration_hours"/>
                            <field name="price"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_padel_booking_calendar" model="ir.ui.view">
        <field name="name">padel.booking.calendar</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <calendar string="Bookings" date_start="start_datetime" date_stop="end_datetime" color="court_id">
                <field name="member_id"/>
                <field name="court_id"/>
            </calendar>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_padel_booking_search" model="ir.ui.view">
        <field name="name">padel.booking.search</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="court_id"/>
                <field name="member_id"/>
                <filter string="Today" name="today" domain="[('start_datetime', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('start_datetime', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <group expand="0" string="Group By">
                    <filter string="Court" name="group_by_court" context="{'group_by': 'court_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>