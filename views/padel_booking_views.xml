<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Booking List View -->
    <record id="view_padel_booking_list" model="ir.ui.view">
        <field name="name">padel.booking.list</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="court_id"/>
                <field name="member_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration_hours"/>
                <field name="price"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'confirmed'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Booking Form View -->
    <record id="view_padel_booking_form" model="ir.ui.view">
        <field name="name">padel.booking.form</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done" type="object" class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="court_id"/>
                            <field name="member_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration_hours"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Booking Calendar View -->
    <record id="view_padel_booking_calendar" model="ir.ui.view">
        <field name="name">padel.booking.calendar</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <calendar string="Bookings Calendar" date_start="start_datetime" date_stop="end_datetime" color="court_id" mode="week">
                <field name="member_id"/>
                <field name="court_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Booking Kanban View -->
    <record id="view_padel_booking_kanban" model="ir.ui.view">
        <field name="name">padel.booking.kanban</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="court_id"/>
                <field name="member_id"/>
                <field name="start_datetime"/>
                <field name="price"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="court_id"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body text-muted small">
                                <div>Member: <field name="member_id"/></div>
                                <div>Date: <field name="start_datetime"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="price" widget="monetary"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-primary="state == 'confirmed'"
                                           decoration-success="state == 'done'"
                                           decoration-danger="state == 'cancelled'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


     <!-- Booking Search View -->
     <record id="view_padel_booking_search" model="ir.ui.view">
         <field name="name">padel.booking.search</field>
         <field name="model">padel.booking</field>
         <field name="arch" type="xml">
             <search>
                 <field name="court_id"/>
                 <field name="member_id"/>

                 <filter string="Draft"
                         name="draft"
                         domain="[('state', '=', 'draft')]"/>

                 <filter string="Confirmed"
                         name="confirmed"
                         domain="[('state', '=', 'confirmed')]"/>

                 <filter string="Done"
                         name="done"
                         domain="[('state', '=', 'done')]"/>

                 <separator/>

                 <group>
                     <filter string="Court"
                             name="group_court"
                             context="{'group_by': 'court_id'}"/>

                     <filter string="Member"
                             name="group_member"
                             context="{'group_by': 'member_id'}"/>

                     <filter string="Status"
                             name="group_state"
                             context="{'group_by': 'state'}"/>
                 </group>
             </search>
         </field>
     </record>
</odoo>