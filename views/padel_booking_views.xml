<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Booking List View -->
    <record id="view_padel_booking_list" model="ir.ui.view">
        <field name="name">padel.booking.list</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="court_id"/>
                <field name="member_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration_hours"/>
                <field name="price"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'confirmed'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Booking Form View -->
    <record id="view_padel_booking_form" model="ir.ui.view">
        <field name="name">padel.booking.form</field>
        <field name="model">padel.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done" type="object" class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="court_id"/>
                            <field name="member_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration_hours"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Booking Action -->
    <record id="action_padel_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">padel.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
