<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_padel_court_list" model="ir.ui.view">
        <field name="name">padel.court.list</field>
        <field name="model">padel.court</field>
        <field name="arch" type="xml">
            <list string="Courts">
                <field name="name"/>
                <field name="court_type"/>
                <field name="hourly_rate"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_padel_court_form" model="ir.ui.view">
        <field name="name">padel.court.form</field>
        <field name="model">padel.court</field>
        <field name="arch" type="xml">
            <form string="Court">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="booking_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="court_type"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="hourly_rate"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>