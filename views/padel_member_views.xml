<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_padel_member_list" model="ir.ui.view">
        <field name="name">padel.member.list</field>
        <field name="model">padel.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="partner_id"/>
                <field name="membership_start"/>
                <field name="level"/>
            </list>
        </field>
    </record>

    <record id="view_padel_member_form" model="ir.ui.view">
        <field name="name">padel.member.form</field>
        <field name="model">padel.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="booking_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <group>
                        <field name="partner_id"/>
                        <field name="membership_start"/>
                        <field name="level"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>