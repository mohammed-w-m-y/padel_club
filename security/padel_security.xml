<odoo>
    <data>
        <record id="module_category_padel" model="ir.module.category">
            <field name="name">Padel Management</field>
        </record>

        <record id="group_padel_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="category_id" ref="module_category_padel"/>
        </record>

        <record id="group_padel_manager" model="res.groups">
            <field name="name">Club Manager</field>
            <field name="category_id" ref="module_category_padel"/>
            <field name="implied_ids" eval="[(4, ref('group_padel_receptionist'))]"/>
        </record>

        <!-- Record Rule: Receptionists see current & future bookings only -->
        <record id="padel_booking_receptionist_rule" model="ir.rule">
            <field name="name">Receptionist Future Bookings Only</field>
            <field name="model_id" ref="model_padel_booking"/>
            <field name="domain_force">[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]</field>
            <field name="groups" eval="[(4, ref('group_padel_receptionist'))]"/>
        </record>
    </data>
</odoo>